{
  "manifest_version": 3,
  "name": "CDDM Browser Delivery",
  "version": "0.1.0",
  "description": "Executes explicitly claimed CDDM prompts in the current ChatGPT conversation.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "CDDM Browser Delivery" },
  "options_page": "options.html"
}
