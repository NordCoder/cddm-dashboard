{
  "manifest_version": 3,
  "name": "CDDM Browser Delivery",
  "version": "0.2.0",
  "key": "",
  "description": "Executes CDDM prompts and provisions exact ChatGPT worker conversations.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://chatgpt.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "CDDM Browser Delivery" },
  "options_page": "options.html"
}
